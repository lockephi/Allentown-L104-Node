  status           - Get engine resilience stats.
  help             - Show this message.

Each command may have additional options; use --help after the command.
Examples:
  l104-code analyze --code "print('hello')"
  l104-code generate --prompt "create a fibonacci function in Python"
  l104-code swift-check --file ./example.swift
    """)

# --- MAIN PARSER ---
def main():
    parser = argparse.ArgumentParser(description="L104 Code Engine CLI")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Analyze
    analyze_parser = subparsers.add_parser("analyze", help="Analyze code")
    analyze_parser.add_argument("--code", type=str, required=True, help="Code to analyze")
    analyze_parser.add_argument("--filename", type=str, default="", help="Optional filename for context")
    analyze_parser.add_argument("--language", type=str, default="", help="Language hint")
    analyze_parser.set_defaults(func=cmd_analyze)

    # Generate
    generate_parser = subparsers.add_parser("generate", help="Generate code from prompt")
    generate_parser.add_argument("--prompt", type=str, required=True, help="Natural language prompt")
    generate_parser.add_argument("--language", type=str, default="Python", help="Target language (default Python)")
    generate_parser.set_defaults(func=cmd_generate)

    # Execute
    execute_parser = subparsers.add_parser("execute", help="Execute code")
    execute_parser.add_argument("--code", type=str, required=True, help="Code to execute")
    execute_parser.set_defaults(func=cmd_execute)

    # Optimize
    optimize_parser = subparsers.add_parser("optimize", help="Optimize code")
    optimize_parser.add_argument("--code", type=str, required=True, help="Code to optimize")
    optimize_parser.add_argument("--filename", type=str, default="", help="Optional filename")
    optimize_parser.set_defaults(func=cmd_optimize)

    # Detect language
    lang_parser = subparsers.add_parser("detect-language", help="Detect programming language")
    lang_parser.add_argument("--code", type=str, required=True, help="Code snippet")
    lang_parser.add_argument("--filename", type=str, default="", help="Optional filename")
    lang_parser.set_defaults(func=cmd_detect_language)

    # Compare languages
    compare_parser = subparsers.add_parser("compare-languages", help="Compare two languages")
    compare_parser.add_argument("--lang-a", type=str, required=True, help="First language")
    compare_parser.add_argument("--lang-b", type=str, required=True, help="Second language")
    compare_parser.set_defaults(func=cmd_compare_languages)

    # Swift check
    swift_parser = subparsers.add_parser("swift-check", help="Check Swift syntax")
    swift_group = swift_parser.add_mutually_exclusive_group(required=True)
    swift_group.add_argument("--code", type=str, help="Swift code string")
    swift_group.add_argument("--file", type=str, help="Path to Swift file")
    swift_parser.set_defaults(func=cmd_swift_check)

    # Batch analyze
    batch_parser = subparsers.add_parser("batch-analyze", help="Batch analyze multiple code files")
    batch_parser.add_argument("--input", type=str, required=True, help="JSON file containing list of {code, filename} objects")
    batch_parser.set_defaults(func=cmd_batch_analyze)

    # Scour
    scour_parser = subparsers.add_parser("scour", help="Recursively analyze code files in a directory")
    scour_parser.add_argument("--path", type=str, default=".", help="Directory path to scan (default: current directory)")
    scour_parser.add_argument("--extensions", type=str, help="Comma-separated list of file extensions (e.g., .py,.js,.ts)")
    scour_parser.add_argument("--max-files", type=int, default=1000, help="Maximum number of files to analyze (default: 1000)")
    scour_parser.set_defaults(func=cmd_scour)

    # Status
    status_parser = subparsers.add_parser("status", help="Get engine resilience stats")
    status_parser.set_defaults(func=cmd_status)

    # Help
    help_parser = subparsers.add_parser("help", help="Show help about the Code Engine")
    help_parser.set_defaults(func=cmd_help)

    args = parser.parse_args()
    if hasattr(args, 'func'):
        args.func(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
