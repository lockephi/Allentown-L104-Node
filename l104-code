#!/usr/bin/env python3
"""
L104 Code Engine CLI
Command‑line interface for the L104 Code Engine.
Provides analysis, generation, optimization, language detection, and Swift checking.
"""

import sys
import os
import argparse
import asyncio
import json
import glob
from typing import Optional, List

# --- ENVIRONMENT SETUP ---
current_dir = os.path.dirname(os.path.abspath(__file__))
os.environ["PYTHONPATH"] = f"{{os.environ.get('PYTHONPATH', '')}}:{{current_dir}}"
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["L104_CPU_CORES"] = "2"

# Add all l104_* directories to path
root = current_dir
for p in glob.glob(os.path.join(root, 'l104_*')):
    if os.path.isdir(p) and not os.path.basename(p).startswith('l104_data'):
        if p not in sys.path:
            sys.path.insert(0, p)

# --- ENGINE IMPORT ---
def get_code_engine():
    from l104_code_engine import code_engine
    return code_engine

# --- COMMAND IMPLEMENTATIONS ---
async def analyze_code(code: str, filename: str = "", language: str = "") -> dict:
    """Analyze code using CodeEngine."""
    engine = get_code_engine()
    if language:
        # Use analyze_with_timeout?
        result = await engine.analyze(code, filename=filename)
    else:
        result = await engine.analyze(code, filename=filename)
    return result

async def generate_code(prompt: str, language: str = "Python") -> str:
    """Generate code from prompt."""
    engine = get_code_engine()
    result = await engine.generate(prompt, language=language)
    return result

async def execute_code(code: str) -> dict:
    """Execute code (if supported)."""
    engine = get_code_engine()
    result = await engine.execute(code)
    return result

async def optimize_code(code: str, filename: str = "") -> dict:
    """Optimize code."""
    engine = get_code_engine()
    result = await engine.optimize(code, filename=filename)
    return result

async def detect_language(code: str, filename: str = "") -> dict:
    """Detect language of code."""
    engine = get_code_engine()
    lang = engine.detect_language(code, filename=filename)
    return {"language": lang}

async def compare_languages(lang_a: str, lang_b: str) -> dict:
    """Compare two languages."""
    engine = get_code_engine()
    result = engine.compare_languages(lang_a, lang_b)
    return result

async def swift_check(code: Optional[str] = None, file_path: Optional[str] = None) -> dict:
    """Check Swift syntax."""
    from l104_code_engine import check_swift_syntax, check_swift_file
    if file_path:
        result = check_swift_file(file_path)
    elif code:
        result = check_swift_syntax(code)
    else:
        return {"error": "Either code or file_path required"}
    return result

async def batch_analyze(file_list: list) -> dict:
    """Batch analyze multiple code files."""
    engine = get_code_engine()
    # Convert list of dicts to list of tuples (code, filename)
    sources = [(item.get('code', ''), item.get('filename', '')) for item in file_list]
    result = engine.batch_analyze(sources)
    return result

async def scour_directory(path: str, extensions: Optional[List[str]] = None, max_files: int = 1000) -> dict:
    """Recursively scan directory and analyze all code files."""
    import os
    import fnmatch
    if extensions is None:
        extensions = ['.py', '.js', '.ts', '.java', '.go', '.rs', '.cpp', '.c', '.swift', '.rb', '.php', '.cs']
    # Normalize extensions to start with dot
    ext_patterns = [ext if ext.startswith('.') else '.' + ext for ext in extensions]
    sources = []
    for root, dirs, files in os.walk(path):
        for file in files:
            if any(file.endswith(ext) for ext in ext_patterns):
                filepath = os.path.join(root, file)
                try:
                    with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                        content = f.read()
                except Exception as e:
                    content = f"# Error reading file: {e}"
                sources.append((content, filepath))
                if len(sources) >= max_files:
                    break
        if len(sources) >= max_files:
            break
    engine = get_code_engine()
    result = engine.batch_analyze(sources)
    return result

async def get_engine_status() -> dict:
    """Get engine resilience stats."""
    engine = get_code_engine()
    stats = engine.get_resilience_stats()
    return stats

# --- SYNC WRAPPERS FOR ARGPARSE ---
def cmd_analyze(args):
    async def run():
        result = await analyze_code(args.code, filename=args.filename, language=args.language)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_generate(args):
    async def run():
        result = await generate_code(args.prompt, language=args.language)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_execute(args):
    async def run():
        result = await execute_code(args.code)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_optimize(args):
    async def run():
        result = await optimize_code(args.code, filename=args.filename)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_detect_language(args):
    async def run():
        result = await detect_language(args.code, filename=args.filename)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_compare_languages(args):
    async def run():
        result = await compare_languages(args.lang_a, args.lang_b)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_swift_check(args):
    async def run():
        result = await swift_check(code=args.code, file_path=args.file)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_batch_analyze(args):
    async def run():
        # Read input JSON file
        with open(args.input, 'r') as f:
            file_list = json.load(f)
        result = await batch_analyze(file_list)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_scour(args):
    async def run():
        extensions = None
        if args.extensions:
            extensions = [ext.strip() for ext in args.extensions.split(',')]
        result = await scour_directory(args.path, extensions=extensions, max_files=args.max_files)
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_status(args):
    async def run():
        result = await get_engine_status()
        print(json.dumps(result, indent=2))
    asyncio.run(run())

def cmd_help(args):
    """Print help about the Code Engine."""
    print("""
L104 Code Engine CLI Help
=========================
Available commands:
  analyze          - Analyze code for smells, complexity, etc.
  generate         - Generate code from a natural language prompt.
